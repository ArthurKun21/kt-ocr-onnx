{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "semanticCommits": "disabled",
  "packageRules": [
    {
      "description": "The bytedeco presets are released in lockstep; update javacpp, openblas and opencv in one PR",
      "matchPackageNames": [
        "org.bytedeco:javacpp",
        "org.bytedeco:openblas",
        "org.bytedeco:opencv"
      ],
      "groupName": "bytedeco JavaCV"
    }
  ]
}
